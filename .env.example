# Optional: enables Gemini-assisted form mapping and grounded answer drafting.
# Keep the real key in a local environment variable or secret manager; never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: discover new Greenhouse/Lever company sources through Brave Search.
# Search is separate from Gemini and can incur search-provider charges.
BRAVE_SEARCH_API_KEY=
# Enable only after confirming your Brave subscription explicitly grants storage rights.
BRAVE_SEARCH_STORAGE_ALLOWED=false
