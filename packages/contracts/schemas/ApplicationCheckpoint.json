{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ApplicationCheckpoint.json",
  "title": "ApplicationCheckpoint",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "applicationId": {
      "$ref": "#/$defs/__schema0"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "running",
        "paused",
        "needs_input",
        "needs_approval",
        "user_takeover",
        "failed_recoverable",
        "review",
        "awaiting_submit_approval",
        "submitting",
        "completed",
        "failed_final",
        "cancelled"
      ]
    },
    "browserSessionRef": {
      "$ref": "#/$defs/__schema0"
    },
    "allowedOrigin": {
      "$ref": "#/$defs/__schema1"
    },
    "url": {
      "$ref": "#/$defs/__schema1"
    },
    "pageFingerprint": {
      "$ref": "#/$defs/__schema2"
    },
    "completedActionIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "fieldDecisionIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "artifactIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "pendingRequestId": {
      "$ref": "#/$defs/__schema0"
    },
    "reviewSnapshotHash": {
      "$ref": "#/$defs/__schema2"
    },
    "lastAuditEventHash": {
      "$ref": "#/$defs/__schema2"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  },
  "required": [
    "id",
    "applicationId",
    "runId",
    "sequence",
    "stateRevision",
    "status",
    "browserSessionRef",
    "allowedOrigin",
    "url",
    "pageFingerprint",
    "completedActionIds",
    "fieldDecisionIds",
    "artifactIds",
    "lastAuditEventHash",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "pattern": "^https?:\\/\\/",
      "description": "HTTP or HTTPS URL. Domain authorization is enforced by policy."
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    }
  }
}
