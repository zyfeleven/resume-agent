{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/Job.json",
  "title": "Job",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "location": {
      "type": "string",
      "maxLength": 240
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/",
      "description": "HTTP or HTTPS URL. Domain authorization is enforced by policy."
    },
    "descriptionArtifactId": {
      "$ref": "#/$defs/__schema0"
    },
    "descriptionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "closed",
        "archived"
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/__schema1"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "id",
    "title",
    "company",
    "descriptionArtifactId",
    "descriptionHash",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  }
}
