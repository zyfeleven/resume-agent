{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentTrustedNonCreationEvidenceRecord.json",
  "title": "DocumentTrustedNonCreationEvidenceRecord",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "proofKind": {
      "type": "string",
      "enum": [
        "executor_not_invoked",
        "storage_transaction_not_started",
        "rollback_confirmed"
      ]
    },
    "operationId": {
      "$ref": "#/$defs/__schema0"
    },
    "actionFingerprint": {
      "$ref": "#/$defs/__schema1"
    },
    "executionReservationId": {
      "$ref": "#/$defs/__schema0"
    },
    "evidenceArtifactIds": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "proofHash": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "proofKind",
    "operationId",
    "actionFingerprint",
    "executionReservationId",
    "evidenceArtifactIds",
    "verifiedAt",
    "proofHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    }
  }
}
