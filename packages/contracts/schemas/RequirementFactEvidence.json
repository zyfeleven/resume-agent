{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/RequirementFactEvidence.json",
  "title": "RequirementFactEvidence",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "factId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "basis": {
      "type": "string",
      "enum": [
        "keyword",
        "term_overlap",
        "term_and_duration",
        "semantic_model"
      ]
    },
    "terms": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "factId",
    "basis",
    "terms"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
