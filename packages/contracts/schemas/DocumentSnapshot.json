{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentSnapshot.json",
  "title": "DocumentSnapshot",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "snapshotId": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_resume",
            "tailored_resume",
            "privacy_scrubbed_document",
            "other"
          ]
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.docx$"
            }
          ],
          "$ref": "#/$defs/__schema1"
        },
        "mediaType": {
          "type": "string",
          "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "parserName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "parserVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "parserProfileHash": {
      "$ref": "#/$defs/__schema2"
    },
    "packageLimits": {
      "type": "object",
      "properties": {
        "maxCompressedBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        },
        "maxExpandedBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 209715200
        },
        "maxEntryBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 52428800
        },
        "maxEntries": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 5000
        },
        "maxCompressionRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "maxNestedArchiveDepth": {
          "type": "number",
          "const": 0
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        }
      },
      "required": [
        "maxCompressedBytes",
        "maxExpandedBytes",
        "maxEntryBytes",
        "maxEntries",
        "maxCompressionRatio",
        "maxNestedArchiveDepth",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "semanticTextHash": {
      "$ref": "#/$defs/__schema2"
    },
    "packagePartSetHash": {
      "$ref": "#/$defs/__schema2"
    },
    "documentModelHash": {
      "$ref": "#/$defs/__schema2"
    },
    "blocks": {
      "maxItems": 20000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "sectionCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "hasComments": {
      "type": "boolean"
    },
    "hasTrackedChanges": {
      "type": "boolean"
    },
    "hasHiddenText": {
      "type": "boolean"
    },
    "hasCustomProperties": {
      "type": "boolean"
    },
    "securityInspection": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "clean"
        },
        "detectedFormat": {
          "type": "string",
          "const": "docx_ooxml"
        },
        "packageMetrics": {
          "type": "object",
          "properties": {
            "compressedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expandedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "largestEntryBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "entryCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCompressionRatio": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "compressedBytes",
            "expandedBytes",
            "largestEntryBytes",
            "entryCount",
            "maximumCompressionRatio"
          ],
          "additionalProperties": false
        },
        "normalizedEntryNamesUnique": {
          "type": "boolean",
          "const": true
        },
        "crcAndSizesVerified": {
          "type": "boolean",
          "const": true
        },
        "hasMacros": {
          "type": "boolean",
          "const": false
        },
        "hasEncryptedPackage": {
          "type": "boolean",
          "const": false
        },
        "hasActiveX": {
          "type": "boolean",
          "const": false
        },
        "hasOleOrEmbeddedPackages": {
          "type": "boolean",
          "const": false
        },
        "hasAltChunk": {
          "type": "boolean",
          "const": false
        },
        "externalRelationshipCount": {
          "type": "number",
          "const": 0
        },
        "unsafeFieldCodeCount": {
          "type": "number",
          "const": 0
        },
        "unsafePackagePathCount": {
          "type": "number",
          "const": 0
        },
        "networkAccessAttempted": {
          "type": "boolean",
          "const": false
        },
        "findings": {
          "maxItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "inspectedAt": {
          "$ref": "#/$defs/__schema5"
        },
        "inspectionHash": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "status",
        "detectedFormat",
        "packageMetrics",
        "normalizedEntryNamesUnique",
        "crcAndSizesVerified",
        "hasMacros",
        "hasEncryptedPackage",
        "hasActiveX",
        "hasOleOrEmbeddedPackages",
        "hasAltChunk",
        "externalRelationshipCount",
        "unsafeFieldCodeCount",
        "unsafePackagePathCount",
        "networkAccessAttempted",
        "findings",
        "inspectedAt",
        "inspectionHash"
      ],
      "additionalProperties": false
    },
    "snapshotArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "const": "document_ir"
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.json$"
            }
          ],
          "$ref": "#/$defs/__schema1"
        },
        "mediaType": {
          "type": "string",
          "const": "application/json"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 52428800
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "$ref": "#/$defs/__schema5"
    },
    "snapshotHash": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "snapshotId",
    "sourceArtifact",
    "parserName",
    "parserVersion",
    "parserProfileHash",
    "packageLimits",
    "semanticTextHash",
    "packagePartSetHash",
    "documentModelHash",
    "blocks",
    "sectionCount",
    "hasComments",
    "hasTrackedChanges",
    "hasHiddenText",
    "hasCustomProperties",
    "securityInspection",
    "snapshotArtifact",
    "createdAt",
    "snapshotHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "story": {
          "type": "string",
          "enum": [
            "body",
            "header",
            "footer",
            "footnote",
            "endnote",
            "text_box"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "paragraph",
            "list_item",
            "table",
            "image",
            "section_break",
            "unknown"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "textHash": {
          "$ref": "#/$defs/__schema2"
        },
        "styleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "listLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "columnCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "normal",
            "pii",
            "sensitive",
            "secret"
          ]
        }
      },
      "required": [
        "id",
        "ordinal",
        "story",
        "kind",
        "text",
        "textHash",
        "sensitivity"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "code": {
          "type": "string",
          "enum": [
            "path_traversal",
            "duplicate_entry",
            "unicode_path_collision",
            "archive_limit_exceeded",
            "invalid_crc_or_size",
            "symlink_or_device_entry",
            "macro",
            "activex",
            "ole_or_embedded_package",
            "alt_chunk",
            "external_relationship",
            "unsafe_field_code",
            "invalid_ooxml_content_type"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "critical"
          ]
        },
        "partNameHash": {
          "$ref": "#/$defs/__schema2"
        },
        "redactedSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "redactedSummary"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  }
}
