{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentPresentationSource.json",
  "title": "DocumentPresentationSource",
  "x-contract-version": "1.0.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "content_item"
        },
        "contentItemId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "kind",
        "contentItemId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "facts"
        },
        "presentationKind": {
          "type": "string",
          "enum": [
            "header",
            "experience_heading"
          ]
        },
        "experienceId": {
          "$ref": "#/$defs/__schema0"
        },
        "factIds": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "kind",
        "presentationKind",
        "factIds"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
