{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/PolicyEvaluationInput.json",
  "title": "PolicyEvaluationInput",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "decisionId": {
      "$ref": "#/$defs/__schema0"
    },
    "policyVersion": {
      "$ref": "#/$defs/__schema1"
    },
    "evaluatedAt": {
      "$ref": "#/$defs/__schema2"
    },
    "automationMode": {
      "$ref": "#/$defs/__schema3"
    },
    "action": {
      "$ref": "#/$defs/__schema4"
    },
    "origin": {
      "$ref": "#/$defs/__schema5"
    },
    "field": {
      "$ref": "#/$defs/__schema7"
    },
    "safetySignals": {
      "$ref": "#/$defs/__schema17"
    }
  },
  "required": [
    "decisionId",
    "policyVersion",
    "evaluatedAt",
    "automationMode",
    "action",
    "origin",
    "safetySignals"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "__schema2": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "standard",
        "review_all"
      ]
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operation": {
          "type": "string",
          "enum": [
            "read",
            "navigate",
            "field_write",
            "control",
            "upload",
            "submit",
            "takeover"
          ]
        },
        "targetIsFinalSubmit": {
          "type": "boolean"
        },
        "controlIntent": {
          "type": "string",
          "enum": [
            "expand",
            "advance_step",
            "previous_step",
            "add_repeated_item",
            "remove_repeated_item"
          ]
        }
      },
      "required": [
        "id",
        "tool",
        "operation",
        "targetIsFinalSubmit"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "targetOrigin": {
          "$ref": "#/$defs/__schema6"
        },
        "currentOrigin": {
          "$ref": "#/$defs/__schema6"
        },
        "allowedOrigins": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        }
      },
      "required": [
        "targetOrigin",
        "allowedOrigins"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#]+\\/?$",
      "description": "HTTP(S) origin only; credentials, paths, query strings, and fragments are forbidden."
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "observationId": {
          "$ref": "#/$defs/__schema0"
        },
        "canonicalField": {
          "$ref": "#/$defs/__schema8"
        },
        "sensitivity": {
          "$ref": "#/$defs/__schema9"
        },
        "confidence": {
          "$ref": "#/$defs/__schema10"
        },
        "provenance": {
          "$ref": "#/$defs/__schema11"
        },
        "factStatus": {
          "$ref": "#/$defs/__schema12"
        },
        "sourceCount": {
          "$ref": "#/$defs/__schema13"
        },
        "answerReuse": {
          "$ref": "#/$defs/__schema14"
        },
        "tags": {
          "$ref": "#/$defs/__schema15"
        }
      },
      "required": [
        "observationId",
        "canonicalField",
        "sensitivity",
        "confidence",
        "provenance",
        "sourceCount",
        "tags"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "__schema9": {
      "type": "string",
      "enum": [
        "normal",
        "pii",
        "sensitive",
        "secret"
      ]
    },
    "__schema10": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "verified_fact",
        "answer_policy",
        "user_input",
        "none"
      ]
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ]
    },
    "__schema13": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "__schema14": {
      "type": "string",
      "enum": [
        "this_application_only",
        "reuse_with_confirmation",
        "always_ask"
      ]
    },
    "__schema15": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema16"
      }
    },
    "__schema16": {
      "type": "string",
      "enum": [
        "protected_attribute",
        "work_authorization",
        "compensation",
        "relocation",
        "availability",
        "legal_declaration",
        "electronic_signature",
        "background_check"
      ]
    },
    "__schema17": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema18"
      }
    },
    "__schema18": {
      "type": "string",
      "enum": [
        "login_required",
        "mfa_required",
        "captcha_present",
        "unfamiliar_widget",
        "untrusted_page_instruction",
        "security_bypass_requested",
        "unexpected_download"
      ]
    }
  }
}
