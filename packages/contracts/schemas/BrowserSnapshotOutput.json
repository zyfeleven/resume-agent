    "__schema2": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "__schema3": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)",
      "description": "HTTP(S) browser URL without embedded credentials."
    },
    "__schema4": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#]+\\/?$",
      "description": "HTTP(S) origin only; credentials, paths, query strings, and fragments are forbidden."
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
