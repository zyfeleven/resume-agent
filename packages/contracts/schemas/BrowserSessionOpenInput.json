{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/BrowserSessionOpenInput.json",
  "title": "BrowserSessionOpenInput",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "applicationId": {
      "$ref": "#/$defs/__schema0"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "targetUrl": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)",
      "description": "HTTP(S) browser URL without embedded credentials."
    },
    "allowedOrigins": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "expectedStateRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headed": {
      "type": "boolean"
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  },
  "required": [
    "contractVersion",
    "requestId",
    "applicationId",
    "runId",
    "targetUrl",
    "allowedOrigins",
    "expectedStateRevision",
    "headed",
    "deadlineAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#]+\\/?$",
      "description": "HTTP(S) origin only; credentials, paths, query strings, and fragments are forbidden."
    }
  }
}
