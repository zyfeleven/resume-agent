{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/RequirementReviewDecision.json",
  "title": "RequirementReviewDecision",
  "x-contract-version": "1.0.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_priority"
        },
        "requirementId": {
          "$ref": "#/$defs/__schema0"
        },
        "priority": {
          "type": "string",
          "enum": [
            "must_have",
            "preferred",
            "context"
          ]
        }
      },
      "required": [
        "action",
        "requirementId",
        "priority"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "set_kind"
        },
        "requirementId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "responsibility",
            "skill",
            "experience",
            "education",
            "credential",
            "behavior",
            "other"
          ]
        }
      },
      "required": [
        "action",
        "requirementId",
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "dismiss"
        },
        "requirementId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "action",
        "requirementId"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
