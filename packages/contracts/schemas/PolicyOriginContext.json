{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/PolicyOriginContext.json",
  "title": "PolicyOriginContext",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "targetOrigin": {
      "$ref": "#/$defs/__schema0"
    },
    "currentOrigin": {
      "$ref": "#/$defs/__schema0"
    },
    "allowedOrigins": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "targetOrigin",
    "allowedOrigins"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#]+\\/?$",
      "description": "HTTP(S) origin only; credentials, paths, query strings, and fragments are forbidden."
    }
  }
}
