{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocxPrivacyScrubInput.json",
  "title": "DocxPrivacyScrubInput",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "operationId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "resumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "expectedResumeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deadlineAt": {
      "$ref": "#/$defs/__schema1"
    },
    "resume": {
      "type": "object",
      "properties": {
        "resumeVersionId": {
          "$ref": "#/$defs/__schema0"
        },
        "profileId": {
          "$ref": "#/$defs/__schema0"
        },
        "expectedResumeRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedResumeStatus": {
          "type": "string",
          "const": "docx_built"
        },
        "sourceContentHash": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "resumeVersionId",
        "profileId",
        "expectedResumeRevision",
        "expectedResumeStatus",
        "sourceContentHash"
      ],
      "additionalProperties": false
    },
    "sourceDocument": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_resume",
            "tailored_resume",
            "privacy_scrubbed_document",
            "other"
          ]
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.docx$"
            }
          ]
        },
        "mediaType": {
          "type": "string",
          "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "sourceSnapshotHash": {
      "$ref": "#/$defs/__schema2"
    },
    "buildManifestHash": {
      "$ref": "#/$defs/__schema2"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "policyHash": {
      "$ref": "#/$defs/__schema2"
    },
    "scrubberProfileHash": {
      "$ref": "#/$defs/__schema2"
    },
    "visibleContentPolicy": {
      "type": "string",
      "const": "preserve_exactly"
    },
    "authorization": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "policy_grant"
            },
            "operationId": {
              "$ref": "#/$defs/__schema0"
            },
            "actionFingerprint": {
              "$ref": "#/$defs/__schema2"
            },
            "resumeVersionId": {
              "$ref": "#/$defs/__schema0"
            },
            "expectedResumeRevision": {
              "$ref": "#/$defs/__schema3"
            },
            "sourceArtifactId": {
              "$ref": "#/$defs/__schema0"
            },
            "sourceArtifactHash": {
              "$ref": "#/$defs/__schema2"
            },
            "risk": {
              "type": "string",
              "const": "reversible"
            },
            "decisionId": {
              "$ref": "#/$defs/__schema0"
            },
            "policyVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "grantHash": {
              "$ref": "#/$defs/__schema2"
            },
            "issuedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "expiresAt": {
              "$ref": "#/$defs/__schema1"
            },
            "executionReservationId": {
              "$ref": "#/$defs/__schema0"
            },
            "executionNonce": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            },
            "executionLeaseExpiresAt": {
              "$ref": "#/$defs/__schema1"
            },
            "tool": {
              "type": "string",
              "const": "docx_privacy_scrub"
            }
          },
          "required": [
            "kind",
            "operationId",
            "actionFingerprint",
            "resumeVersionId",
            "expectedResumeRevision",
            "sourceArtifactId",
            "sourceArtifactHash",
            "risk",
            "decisionId",
            "policyVersion",
            "grantHash",
            "issuedAt",
            "expiresAt",
            "executionReservationId",
            "executionNonce",
            "executionLeaseExpiresAt",
            "tool"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "effect_claim"
            },
            "operationId": {
              "$ref": "#/$defs/__schema0"
            },
            "actionFingerprint": {
              "$ref": "#/$defs/__schema2"
            },
            "resumeVersionId": {
              "$ref": "#/$defs/__schema0"
            },
            "expectedResumeRevision": {
              "$ref": "#/$defs/__schema3"
            },
            "sourceArtifactId": {
              "$ref": "#/$defs/__schema0"
            },
            "sourceArtifactHash": {
              "$ref": "#/$defs/__schema2"
            },
            "risk": {
              "type": "string",
              "const": "reversible"
            },
            "approvalId": {
              "$ref": "#/$defs/__schema0"
            },
            "dispatchEffectId": {
              "$ref": "#/$defs/__schema0"
            },
            "workerId": {
              "$ref": "#/$defs/__schema0"
            },
            "claimToken": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            },
            "claimedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "expiresAt": {
              "$ref": "#/$defs/__schema1"
            },
            "executionReservationId": {
              "$ref": "#/$defs/__schema0"
            },
            "executionNonce": {
              "type": "string",
              "minLength": 32,
              "maxLength": 512
            },
            "executionLeaseExpiresAt": {
              "$ref": "#/$defs/__schema1"
            },
            "tool": {
              "type": "string",
              "const": "docx_privacy_scrub"
            }
          },
          "required": [
            "kind",
            "operationId",
            "actionFingerprint",
            "resumeVersionId",
            "expectedResumeRevision",
            "sourceArtifactId",
            "sourceArtifactHash",
            "risk",
            "approvalId",
            "dispatchEffectId",
            "workerId",
            "claimToken",
            "claimedAt",
            "expiresAt",
            "executionReservationId",
            "executionNonce",
            "executionLeaseExpiresAt",
            "tool"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "contractVersion",
    "requestId",
    "operationId",
    "profileId",
    "deadlineAt",
    "resume",
    "sourceDocument",
    "sourceSnapshotHash",
    "buildManifestHash",
    "policyVersion",
    "policyHash",
    "scrubberProfileHash",
    "visibleContentPolicy",
    "authorization"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
