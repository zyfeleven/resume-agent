      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "__schema3": {
      "type": "string",
      "pattern": "^https?:\\/\\/",
      "description": "HTTP or HTTPS URL. Domain authorization is enforced by policy."
    },
    "__schema4": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    }
  }
