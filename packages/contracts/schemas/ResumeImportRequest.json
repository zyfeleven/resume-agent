{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeImportRequest.json",
  "title": "ResumeImportRequest",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "source": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
        },
        "format": {
          "type": "string",
          "enum": [
            "docx",
            "plain_text",
            "markdown"
          ]
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase SHA-256 digest."
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "artifactId",
        "fileName",
        "format",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400000,
      "description": "Plain text already extracted from the source artifact by a trusted parser. The extractor never reads file paths, URLs, or raw bytes."
    },
    "importedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  },
  "required": [
    "profileId",
    "source",
    "text",
    "importedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
