{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeDocumentBuild.json",
  "title": "ResumeDocumentBuild",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "resumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "changeSetId": {
      "$ref": "#/$defs/__schema0"
    },
    "changeSetHash": {
      "$ref": "#/$defs/__schema1"
    },
    "factSnapshotHash": {
      "$ref": "#/$defs/__schema1"
    },
    "contentApprovalId": {
      "$ref": "#/$defs/__schema0"
    },
    "approvedContentHash": {
      "$ref": "#/$defs/__schema1"
    },
    "templateId": {
      "$ref": "#/$defs/__schema0"
    },
    "templateVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "templateHash": {
      "$ref": "#/$defs/__schema1"
    },
    "builderName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "builderVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "outputArtifactId": {
      "$ref": "#/$defs/__schema0"
    },
    "outputHash": {
      "$ref": "#/$defs/__schema1"
    },
    "outputByteSize": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "documentTextHash": {
      "$ref": "#/$defs/__schema1"
    },
    "blocks": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "builtAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  },
  "required": [
    "id",
    "resumeVersionId",
    "profileId",
    "changeSetId",
    "changeSetHash",
    "factSnapshotHash",
    "contentApprovalId",
    "approvedContentHash",
    "templateId",
    "builderName",
    "builderVersion",
    "outputArtifactId",
    "outputHash",
    "outputByteSize",
    "documentTextHash",
    "blocks",
    "builtAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "blockId": {
          "$ref": "#/$defs/__schema0"
        },
        "section": {
          "$ref": "#/$defs/__schema3"
        },
        "style": {
          "$ref": "#/$defs/__schema4"
        },
        "text": {
          "$ref": "#/$defs/__schema5"
        },
        "textHash": {
          "$ref": "#/$defs/__schema1"
        },
        "factIds": {
          "$ref": "#/$defs/__schema6"
        },
        "contentItemId": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "blockId",
        "section",
        "style",
        "text",
        "textHash",
        "factIds"
      ],
      "additionalProperties": false,
      "description": "One paragraph of the generated document. Every block cites the verified facts its text came from, so no line of the output is unattributable."
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "header",
        "summary",
        "experience",
        "skills",
        "projects",
        "education"
      ]
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "name",
        "contact",
        "heading",
        "entry_heading",
        "entry_meta",
        "bullet",
        "line"
      ]
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "__schema6": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema7": {
      "$ref": "#/$defs/__schema0"
    }
  }
}
