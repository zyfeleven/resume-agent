{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/TemplateInspectOutput.json",
  "title": "TemplateInspectOutput",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "type": "string",
              "const": "1.0.0"
            },
            "requestId": {
              "$ref": "#/$defs/__schema0"
            },
            "operationId": {
              "$ref": "#/$defs/__schema0"
            },
            "profileId": {
              "$ref": "#/$defs/__schema0"
            },
            "tool": {
              "type": "string",
              "const": "template_inspect"
            },
            "startedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "completedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "outcome": {
              "type": "string",
              "const": "success"
            },
            "template": {
              "type": "object",
              "properties": {
                "templateId": {
                  "$ref": "#/$defs/__schema0"
                },
                "templateVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "templateArtifact": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "source_resume",
                        "tailored_resume",
                        "privacy_scrubbed_document",
                        "other"
                      ]
                    },
                    "fileName": {
                      "allOf": [
                        {
                          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
                        },
                        {
                          "pattern": "\\.docx$"
                        }
                      ],
                      "$ref": "#/$defs/__schema2"
                    },
                    "mediaType": {
                      "type": "string",
                      "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                    },
                    "contentHash": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "byteSize": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 26214400
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "fileName",
                    "mediaType",
                    "contentHash",
                    "byteSize"
                  ],
                  "additionalProperties": false
                },
                "sourceSnapshotHash": {
                  "$ref": "#/$defs/__schema3"
                },
                "inspectorName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "inspectorVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "slots": {
                  "minItems": 1,
                  "maxItems": 2000,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema4"
                  }
                },
                "staticBlockIds": {
                  "maxItems": 20000,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "immutablePartHashes": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema3"
                  }
                },
                "pageWidthDxa": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "pageHeightDxa": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "marginTopDxa": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "marginRightDxa": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "marginBottomDxa": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "marginLeftDxa": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "requiredFontNames": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema5"
                  }
                },
                "inspectionProfileHash": {
                  "$ref": "#/$defs/__schema3"
                },
                "packageLimits": {
                  "type": "object",
                  "properties": {
                    "maxCompressedBytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 26214400
                    },
                    "maxExpandedBytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 209715200
                    },
                    "maxEntryBytes": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 52428800
                    },
                    "maxEntries": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 5000
                    },
                    "maxCompressionRatio": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    },
                    "maxNestedArchiveDepth": {
                      "type": "number",
                      "const": 0
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 120000
                    }
                  },
                  "required": [
                    "maxCompressedBytes",
                    "maxExpandedBytes",
                    "maxEntryBytes",
                    "maxEntries",
                    "maxCompressionRatio",
                    "maxNestedArchiveDepth",
                    "timeoutMs"
                  ],
                  "additionalProperties": false
                },
                "profileArtifact": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "kind": {
                      "type": "string",
                      "const": "document_inspection"
                    },
                    "fileName": {
                      "allOf": [
                        {
                          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
                        },
                        {
                          "pattern": "\\.json$"
                        }
                      ],
                      "$ref": "#/$defs/__schema2"
                    },
                    "mediaType": {
                      "type": "string",
                      "const": "application/json"
                    },
                    "contentHash": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "byteSize": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 52428800
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "fileName",
                    "mediaType",
                    "contentHash",
                    "byteSize"
                  ],
                  "additionalProperties": false
                },
                "inspectedAt": {
                  "$ref": "#/$defs/__schema1"
                },
                "profileHash": {
                  "$ref": "#/$defs/__schema3"
                }
              },
              "required": [
                "templateId",
                "templateVersion",
                "templateArtifact",
                "sourceSnapshotHash",
                "inspectorName",
                "inspectorVersion",
                "slots",
                "staticBlockIds",
                "immutablePartHashes",
                "pageWidthDxa",
                "pageHeightDxa",
                "marginTopDxa",
                "marginRightDxa",
                "marginBottomDxa",
                "marginLeftDxa",
                "requiredFontNames",
                "inspectionProfileHash",
                "packageLimits",
                "profileArtifact",
                "inspectedAt",
                "profileHash"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contractVersion",
            "requestId",
            "operationId",
            "profileId",
            "tool",
            "startedAt",
            "completedAt",
            "outcome",
            "template"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "type": "string",
              "const": "1.0.0"
            },
            "requestId": {
              "$ref": "#/$defs/__schema0"
            },
            "operationId": {
              "$ref": "#/$defs/__schema0"
            },
            "profileId": {
              "$ref": "#/$defs/__schema0"
            },
            "tool": {
              "type": "string",
              "const": "template_inspect"
            },
            "startedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "completedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "blocked",
                "retryable_failure",
                "fatal_failure"
              ]
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "redacted": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "code",
                "message",
                "redacted"
              ],
              "additionalProperties": false
            },
            "evidenceArtifactIds": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "contractVersion",
            "requestId",
            "operationId",
            "profileId",
            "tool",
            "startedAt",
            "completedAt",
            "outcome",
            "error",
            "evidenceArtifactIds"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "result"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "slotId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "header",
            "summary",
            "skills",
            "experience",
            "projects",
            "education"
          ]
        },
        "targetBlockIds": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "styleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "maxCharacters": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "maxItems": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 500
        }
      },
      "required": [
        "slotId",
        "kind",
        "targetBlockIds",
        "styleId"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  }
}
