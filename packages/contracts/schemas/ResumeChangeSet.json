{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeChangeSet.json",
  "title": "ResumeChangeSet",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
