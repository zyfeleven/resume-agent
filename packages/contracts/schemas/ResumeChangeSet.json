              "requirementIds": {
                "$ref": "#/$defs/__schema3"
              },
              "rationale": {
                "$ref": "#/$defs/__schema4"
              },
              "intent": {
                "type": "string",
                "const": "keep"
              },
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "targetItemId",
              "factIds",
              "requirementIds",
              "rationale",
              "intent",
              "before"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "targetItemId": {
                "$ref": "#/$defs/__schema0"
              },
              "factIds": {
                "$ref": "#/$defs/__schema2"
              },
              "requirementIds": {
                "$ref": "#/$defs/__schema3"
              },
              "rationale": {
                "$ref": "#/$defs/__schema4"
              },
              "intent": {
                "type": "string",
                "const": "rewrite"
              },
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "targetItemId",
              "factIds",
              "requirementIds",
              "rationale",
              "intent",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "targetItemId": {
                "$ref": "#/$defs/__schema0"
              },
              "factIds": {
                "$ref": "#/$defs/__schema2"
              },
              "requirementIds": {
                "$ref": "#/$defs/__schema3"
              },
              "rationale": {
                "$ref": "#/$defs/__schema4"
              },
              "intent": {
                "type": "string",
                "const": "combine"
              },
              "sourceItemIds": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "before": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema5"
                }
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
