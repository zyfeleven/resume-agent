    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "baseResumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "baseContentHash": {
      "$ref": "#/$defs/__schema1"
    },
    "resultContentHash": {
      "$ref": "#/$defs/__schema1"
    },
    "factSnapshotHash": {
