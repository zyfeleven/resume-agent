              "id",
              "targetItemId",
              "factIds",
              "requirementIds",
              "rationale",
              "intent",
              "sourceItemIds",
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "targetItemId": {
                "$ref": "#/$defs/__schema0"
              },
              "factIds": {
                "$ref": "#/$defs/__schema2"
              },
              "requirementIds": {
                "$ref": "#/$defs/__schema3"
