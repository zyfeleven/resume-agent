{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ClaimViolation.json",
  "title": "ClaimViolation",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "changeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "code": {
      "type": "string",
      "enum": [
        "fact_not_verified",
        "fact_not_in_snapshot",
        "requirement_not_in_snapshot",
        "before_text_altered",
        "unsupported_claim",
        "unsupported_number",
        "fact_snapshot_mismatch"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "code",
    "detail"
  ],
  "additionalProperties": false
}
