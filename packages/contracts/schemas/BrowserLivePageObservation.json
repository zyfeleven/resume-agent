{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/BrowserLivePageObservation.json",
  "title": "BrowserLivePageObservation",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "applicationId": {
      "$ref": "#/$defs/__schema0"
    },
    "runId": {
      "$ref": "#/$defs/__schema0"
    },
    "browserSessionRef": {
      "$ref": "#/$defs/__schema0"
    },
    "pageGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "url": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)",
      "description": "HTTP(S) browser URL without embedded credentials."
    },
    "origin": {
      "type": "string",
      "pattern": "^https?:\\/\\/(?![^/?#]*@)[^/?#]+\\/?$",
      "description": "HTTP(S) origin only; credentials, paths, query strings, and fragments are forbidden."
    },
    "pageFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  },
  "required": [
    "applicationId",
    "runId",
    "browserSessionRef",
    "pageGeneration",
    "url",
    "origin",
    "pageFingerprint",
    "observedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
