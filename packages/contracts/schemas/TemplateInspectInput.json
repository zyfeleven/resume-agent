{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/TemplateInspectInput.json",
  "title": "TemplateInspectInput",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "$ref": "#/$defs/__schema0"
    },
    "operationId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "resumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "expectedResumeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deadlineAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "templateDocument": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_resume",
            "tailored_resume",
            "privacy_scrubbed_document",
            "other"
          ]
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.docx$"
            }
          ]
        },
        "mediaType": {
          "type": "string",
          "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema1"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "packageLimits": {
      "type": "object",
      "properties": {
        "maxCompressedBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        },
        "maxExpandedBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 209715200
        },
        "maxEntryBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 52428800
        },
        "maxEntries": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 5000
        },
        "maxCompressionRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "maxNestedArchiveDepth": {
          "type": "number",
          "const": 0
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        }
      },
      "required": [
        "maxCompressedBytes",
        "maxExpandedBytes",
        "maxEntryBytes",
        "maxEntries",
        "maxCompressionRatio",
        "maxNestedArchiveDepth",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "inspectionProfileHash": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "contractVersion",
    "requestId",
    "operationId",
    "profileId",
    "deadlineAt",
    "templateDocument",
    "packageLimits",
    "inspectionProfileHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    }
  }
}
