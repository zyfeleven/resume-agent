{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentExportManifest.json",
  "title": "DocumentExportManifest",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "manifestId": {
      "$ref": "#/$defs/__schema0"
    },
    "operationId": {
      "$ref": "#/$defs/__schema0"
    },
    "resumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceDocument": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_resume",
            "tailored_resume",
            "privacy_scrubbed_document",
            "other"
          ]
        },
        "fileName": {
          "$ref": "#/$defs/__schema1"
        },
        "mediaType": {
          "$ref": "#/$defs/__schema3"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema4"
        },
        "byteSize": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "exportedDocument": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "const": "document_export"
        },
        "fileName": {
          "$ref": "#/$defs/__schema1"
        },
        "mediaType": {
          "$ref": "#/$defs/__schema3"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema4"
        },
        "byteSize": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "contentApprovalId": {
      "$ref": "#/$defs/__schema0"
    },
    "contentApprovalHash": {
      "$ref": "#/$defs/__schema4"
    },
    "buildManifestHash": {
      "$ref": "#/$defs/__schema4"
    },
    "privacyReportHash": {
      "$ref": "#/$defs/__schema4"
    },
    "renderSetHash": {
      "$ref": "#/$defs/__schema4"
    },
    "qaReportHash": {
      "$ref": "#/$defs/__schema4"
    },
    "format": {
      "type": "string",
      "const": "docx"
    },
    "destination": {
      "type": "string",
      "const": "user_download"
    },
    "exactBytePromotion": {
      "type": "boolean",
      "const": true
    },
    "manifestArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "const": "document_manifest"
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.json$"
            }
          ],
          "$ref": "#/$defs/__schema2"
        },
        "mediaType": {
          "type": "string",
          "const": "application/json"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema4"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 52428800
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "manifestHash": {
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": [
    "manifestId",
    "operationId",
    "resumeVersionId",
    "profileId",
    "sourceDocument",
    "exportedDocument",
    "contentApprovalId",
    "contentApprovalHash",
    "buildManifestHash",
    "privacyReportHash",
    "renderSetHash",
    "qaReportHash",
    "format",
    "destination",
    "exactBytePromotion",
    "manifestArtifact",
    "exportedAt",
    "manifestHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "allOf": [
        {
          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
        },
        {
          "pattern": "\\.docx$"
        }
      ],
      "$ref": "#/$defs/__schema2"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "__schema3": {
      "type": "string",
      "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema5": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 26214400
    }
  }
}
