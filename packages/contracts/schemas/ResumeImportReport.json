{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeImportReport.json",
  "title": "ResumeImportReport",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "artifactId": {
      "$ref": "#/$defs/__schema0"
    },
    "extractorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "importedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "sourceLineCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "header",
              "summary",
              "skills",
              "experience",
              "education",
              "projects",
              "certifications",
              "work_authorization",
              "unrecognized"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "startLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "endLine": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "startLine",
          "endLine"
        ],
        "additionalProperties": false
      }
    },
    "factCounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "identity",
              "contact",
              "employment",
              "achievement",
              "skill",
              "education",
              "project",
              "credential",
              "preference",
              "work_authorization"
            ]
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "factIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "$ref": "#/$defs/__schema1"
          },
          "reason": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": [
          "line",
          "reason"
        ],
        "additionalProperties": false,
        "description": "A source line that produced no fact. Skipped text is never copied into the report, so a suspected secret cannot leak through import telemetry."
      }
    }
  },
  "required": [
    "id",
    "profileId",
    "artifactId",
    "extractorVersion",
    "importedAt",
    "sourceLineCount",
    "sections",
    "factCounts",
    "factIds",
    "skipped"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "possible_secret",
        "duplicate_fact",
        "line_too_long",
        "unattached_bullet",
        "unrecognized_line"
      ]
    }
  }
}
