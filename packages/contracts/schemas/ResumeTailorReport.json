{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeTailorReport.json",
  "title": "ResumeTailorReport",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "changeSetId": {
      "$ref": "#/$defs/__schema0"
    },
    "baseResumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "generatorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "verifiedFactCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "keptItemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "removedItemCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "$ref": "#/$defs/__schema0"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must_have",
              "preferred",
              "context"
            ]
          },
          "strength": {
            "type": "string",
            "enum": [
              "exact",
              "related",
              "missing"
            ]
          },
          "factIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "requirementId",
          "priority",
          "strength",
          "factIds"
        ],
        "additionalProperties": false
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/$defs/__schema1"
          },
          "reason": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": [
          "key",
          "reason"
        ],
        "additionalProperties": false,
        "description": "A resume entry that could not be built because the facts behind it are not verified. The entry is reported, never filled in from unverified data."
      }
    }
  },
  "required": [
    "id",
    "jobId",
    "profileId",
    "changeSetId",
    "baseResumeVersionId",
    "generatorVersion",
    "generatedAt",
    "verifiedFactCount",
    "keptItemCount",
    "removedItemCount",
    "coverage",
    "skipped"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "unverified_role",
        "unverified_organization",
        "unverified_dates",
        "unverified_fact"
      ]
    }
  }
}
