{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ClaimGuardReport.json",
  "title": "ClaimGuardReport",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "changeSetId": {
      "$ref": "#/$defs/__schema0"
    },
    "layer": {
      "default": "deterministic",
      "type": "string",
      "enum": [
        "deterministic",
        "semantic"
      ]
    },
    "guardVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "passed": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "changeId": {
            "$ref": "#/$defs/__schema0"
          },
          "code": {
            "type": "string",
            "enum": [
              "fact_not_verified",
              "fact_not_in_snapshot",
              "requirement_not_in_snapshot",
              "before_text_altered",
              "unsupported_claim",
              "unsupported_number",
              "fact_snapshot_mismatch",
              "semantic_negation_conflict",
              "semantic_direction_conflict",
              "semantic_responsibility_inflation",
              "semantic_proficiency_inflation"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "changeSetId",
    "layer",
    "guardVersion",
    "checkedAt",
    "passed",
    "violations"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
