{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentTrustedRequirementRecord.json",
  "title": "DocumentTrustedRequirementRecord",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "requirementId": {
      "$ref": "#/$defs/__schema0"
    },
    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "requirementHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    }
  },
  "required": [
    "requirementId",
    "jobId",
    "requirementHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
