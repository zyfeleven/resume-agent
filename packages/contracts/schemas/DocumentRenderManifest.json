{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentRenderManifest.json",
  "title": "DocumentRenderManifest",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "manifestId": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceDocument": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_resume",
            "tailored_resume",
            "privacy_scrubbed_document",
            "other"
          ]
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.docx$"
            }
          ],
          "$ref": "#/$defs/__schema1"
        },
        "mediaType": {
          "type": "string",
          "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "rendererName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "rendererVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "runtimeHash": {
      "$ref": "#/$defs/__schema2"
    },
    "configurationHash": {
      "$ref": "#/$defs/__schema2"
    },
    "fontPackHash": {
      "$ref": "#/$defs/__schema2"
    },
    "revisionView": {
      "type": "string",
      "enum": [
        "clean",
        "final_showing_markup"
      ]
    },
    "pageCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "pages": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "qaStatus": {
      "type": "string",
      "const": "pending"
    },
    "manifestArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "const": "document_manifest"
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.json$"
            }
          ],
          "$ref": "#/$defs/__schema1"
        },
        "mediaType": {
          "type": "string",
          "const": "application/json"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 52428800
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "renderedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "renderSetHash": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "manifestId",
    "sourceDocument",
    "rendererName",
    "rendererVersion",
    "runtimeHash",
    "configurationHash",
    "fontPackHash",
    "revisionView",
    "pageCount",
    "pages",
    "qaStatus",
    "manifestArtifact",
    "renderedAt",
    "renderSetHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "artifact": {
          "type": "object",
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "type": "string",
              "enum": [
                "document_render",
                "document_render_page",
                "other"
              ]
            },
            "fileName": {
              "allOf": [
                {
                  "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
                },
                {
                  "pattern": "\\.png$"
                }
              ],
              "$ref": "#/$defs/__schema1"
            },
            "mediaType": {
              "type": "string",
              "const": "image/png"
            },
            "contentHash": {
              "$ref": "#/$defs/__schema2"
            },
            "byteSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 52428800
            }
          },
          "required": [
            "artifactId",
            "kind",
            "fileName",
            "mediaType",
            "contentHash",
            "byteSize"
          ],
          "additionalProperties": false
        },
        "widthPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "heightPixels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "dpi": {
          "type": "integer",
          "minimum": 72,
          "maximum": 600
        }
      },
      "required": [
        "pageNumber",
        "artifact",
        "widthPixels",
        "heightPixels",
        "dpi"
      ],
      "additionalProperties": false
    }
  }
}
