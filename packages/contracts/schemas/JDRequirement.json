{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/JDRequirement.json",
  "title": "JDRequirement",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "kind": {
      "type": "string",
      "enum": [
        "responsibility",
        "skill",
        "experience",
        "education",
        "credential",
        "behavior",
        "other"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "must_have",
        "preferred",
        "context"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "artifactId",
        "locator"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "jobId",
    "kind",
    "priority",
    "text",
    "keywords",
    "source"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
