{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocxVisualDiffOutput.json",
  "title": "DocxVisualDiffOutput",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "type": "string",
              "const": "1.0.0"
            },
            "requestId": {
              "$ref": "#/$defs/__schema0"
            },
            "operationId": {
              "$ref": "#/$defs/__schema0"
            },
            "profileId": {
              "$ref": "#/$defs/__schema0"
            },
            "tool": {
              "type": "string",
              "const": "docx_visual_diff"
            },
            "startedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "completedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "outcome": {
              "type": "string",
              "const": "success"
            },
            "report": {
              "type": "object",
              "properties": {
                "reportId": {
                  "$ref": "#/$defs/__schema0"
                },
                "baseRenderSetHash": {
                  "$ref": "#/$defs/__schema2"
                },
                "candidateRenderSetHash": {
                  "$ref": "#/$defs/__schema2"
                },
                "comparatorName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "comparatorVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "runtimeHash": {
                  "$ref": "#/$defs/__schema2"
                },
                "configurationHash": {
                  "$ref": "#/$defs/__schema2"
                },
                "pages": {
                  "minItems": 1,
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema3"
                  }
                },
                "addedPageCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "removedPageCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reportArtifact": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "kind": {
                      "type": "string",
                      "const": "document_diff"
                    },
                    "fileName": {
                      "allOf": [
                        {
                          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
                        },
                        {
                          "pattern": "\\.json$"
                        }
                      ],
                      "$ref": "#/$defs/__schema6"
                    },
                    "mediaType": {
                      "type": "string",
                      "const": "application/json"
                    },
                    "contentHash": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "byteSize": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 52428800
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "fileName",
                    "mediaType",
                    "contentHash",
                    "byteSize"
                  ],
                  "additionalProperties": false
                },
                "createdAt": {
                  "$ref": "#/$defs/__schema1"
                },
                "reportHash": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "reportId",
                "baseRenderSetHash",
                "candidateRenderSetHash",
                "comparatorName",
                "comparatorVersion",
                "runtimeHash",
                "configurationHash",
                "pages",
                "addedPageCount",
                "removedPageCount",
                "reportArtifact",
                "createdAt",
                "reportHash"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "contractVersion",
            "requestId",
            "operationId",
            "profileId",
            "tool",
            "startedAt",
            "completedAt",
            "outcome",
            "report"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "type": "string",
              "const": "1.0.0"
            },
            "requestId": {
              "$ref": "#/$defs/__schema0"
            },
            "operationId": {
              "$ref": "#/$defs/__schema0"
            },
            "profileId": {
              "$ref": "#/$defs/__schema0"
            },
            "tool": {
              "type": "string",
              "const": "docx_visual_diff"
            },
            "startedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "completedAt": {
              "$ref": "#/$defs/__schema1"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "blocked",
                "retryable_failure",
                "fatal_failure"
              ]
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "redacted": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "code",
                "message",
                "redacted"
              ],
              "additionalProperties": false
            },
            "evidenceArtifactIds": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "contractVersion",
            "requestId",
            "operationId",
            "profileId",
            "tool",
            "startedAt",
            "completedAt",
            "outcome",
            "error",
            "evidenceArtifactIds"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "result"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "basePage": {
          "$ref": "#/$defs/__schema4"
        },
        "candidatePage": {
          "$ref": "#/$defs/__schema4"
        },
        "diffImage": {
          "type": "object",
          "properties": {
            "artifactId": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "type": "string",
              "const": "document_render"
            },
            "fileName": {
              "$ref": "#/$defs/__schema5"
            },
            "mediaType": {
              "$ref": "#/$defs/__schema7"
            },
            "contentHash": {
              "$ref": "#/$defs/__schema2"
            },
            "byteSize": {
              "$ref": "#/$defs/__schema8"
            }
          },
          "required": [
            "artifactId",
            "kind",
            "fileName",
            "mediaType",
            "contentHash",
            "byteSize"
          ],
          "additionalProperties": false
        },
        "changedPixelRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dimensionsMatch": {
          "type": "boolean"
        }
      },
      "required": [
        "pageNumber",
        "candidatePage",
        "diffImage",
        "changedPixelRatio",
        "dimensionsMatch"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "document_render",
            "document_render_page",
            "other"
          ]
        },
        "fileName": {
          "$ref": "#/$defs/__schema5"
        },
        "mediaType": {
          "$ref": "#/$defs/__schema7"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema2"
        },
        "byteSize": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "allOf": [
        {
          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
        },
        {
          "pattern": "\\.png$"
        }
      ],
      "$ref": "#/$defs/__schema6"
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "__schema7": {
      "type": "string",
      "const": "image/png"
    },
    "__schema8": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 52428800
    }
  }
}
