        "inspectorId": {
          "$ref": "#/$defs/__schema0"
        },
        "inspectedAt": {
          "$ref": "#/$defs/__schema1"
        },
        "zoomPercent": {
          "type": "number",
          "const": 100
        },
        "clipping": {
          "type": "boolean"
        },
        "overlap": {
          "type": "boolean"
        },
        "missingGlyph": {
          "type": "boolean"
        },
        "fontFallback": {
          "type": "boolean"
        },
        "tableOverflow": {
          "type": "boolean"
        },
        "bulletMisalignment": {
          "type": "boolean"
        },
        "headerFooterCollision": {
          "type": "boolean"
        },
        "unexpectedPageBreak": {
          "type": "boolean"
        },
        "orphanHeading": {
          "type": "boolean"
        },
        "unexpectedBlankPage": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "evidenceArtifactIds": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "pageNumber",
        "pageArtifact",
        "inspectorType",
        "inspectorId",
        "inspectedAt",
        "zoomPercent",
        "clipping",
        "overlap",
        "missingGlyph",
        "fontFallback",
        "tableOverflow",
        "bulletMisalignment",
        "headerFooterCollision",
        "unexpectedPageBreak",
        "orphanHeading",
        "unexpectedBlankPage",
        "status",
        "evidenceArtifactIds"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "check": {
          "$ref": "#/$defs/__schema4"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocking"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "redactedSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pageNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "evidenceArtifactIds": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "check",
        "severity",
        "code",
        "redactedSummary",
        "evidenceArtifactIds"
      ],
      "additionalProperties": false
