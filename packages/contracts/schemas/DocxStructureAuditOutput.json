            "fileName": {
              "allOf": [
                {
                  "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
                },
                {
                  "pattern": "\\.png$"
                }
              ],
              "$ref": "#/$defs/__schema2"
            },
            "mediaType": {
              "type": "string",
              "const": "image/png"
            },
            "contentHash": {
              "$ref": "#/$defs/__schema3"
