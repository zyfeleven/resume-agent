{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/FactConflictDecision.json",
  "title": "FactConflictDecision",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "conflictId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "kind": {
      "type": "string",
      "enum": [
        "identity",
        "contact",
        "employment",
        "achievement",
        "skill",
        "education",
        "project",
        "credential",
        "preference",
        "work_authorization"
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "candidateFactIds": {
      "minItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "selectedFactId": {
      "$ref": "#/$defs/__schema0"
    },
    "reviewedConflictHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "decidedBy": {
      "$ref": "#/$defs/__schema0"
    },
    "decidedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  },
  "required": [
    "id",
    "conflictId",
    "profileId",
    "kind",
    "key",
    "candidateFactIds",
    "selectedFactId",
    "reviewedConflictHash",
    "decidedBy",
    "decidedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
