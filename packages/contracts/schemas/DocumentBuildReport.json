{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentBuildReport.json",
  "title": "DocumentBuildReport",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "buildId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "verifierVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "passed": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "approval_content_mismatch",
              "change_set_mismatch",
              "block_not_fact_backed",
              "block_text_not_in_document",
              "document_text_mismatch",
              "output_hash_mismatch",
              "unapproved_text_in_document"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "buildId",
    "verifierVersion",
    "checkedAt",
    "passed",
    "failures"
  ],
  "additionalProperties": false
}
