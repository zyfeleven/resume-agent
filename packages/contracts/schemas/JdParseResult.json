{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/JdParseResult.json",
  "title": "JdParseResult",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "report": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "jobId": {
          "$ref": "#/$defs/__schema0"
        },
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "parserVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "parsedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "RFC 3339 timestamp with an explicit UTC offset."
        },
        "sourceLineCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "intro",
                  "responsibilities",
                  "requirements",
                  "preferred",
                  "benefits",
                  "about",
                  "legal",
                  "unrecognized"
                ]
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "startLine",
              "endLine"
            ],
            "additionalProperties": false
          }
        },
        "priorityCounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "priority": {
                "$ref": "#/$defs/__schema1"
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "priority",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line": {
                "$ref": "#/$defs/__schema2"
              },
              "reason": {
                "$ref": "#/$defs/__schema3"
              }
            },
            "required": [
              "line",
              "reason"
            ],
            "additionalProperties": false,
            "description": "A source line that produced no requirement. Skipped text is never copied into the report, so agent-directed text in a job posting cannot reach a prompt through parse telemetry."
          }
        }
      },
      "required": [
        "id",
        "jobId",
        "artifactId",
        "parserVersion",
        "parsedAt",
        "sourceLineCount",
        "sections",
        "priorityCounts",
        "requirementIds",
        "skipped"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "jobId": {
            "$ref": "#/$defs/__schema0"
          },
          "kind": {
            "type": "string",
            "enum": [
              "responsibility",
              "skill",
              "experience",
              "education",
              "credential",
              "behavior",
              "other"
            ]
          },
          "priority": {
            "$ref": "#/$defs/__schema1"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "artifactId": {
                "$ref": "#/$defs/__schema0"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "excerpt": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "artifactId",
              "locator"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "jobId",
          "kind",
          "priority",
          "text",
          "keywords",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "report",
    "requirements"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "must_have",
        "preferred",
        "context"
      ]
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "possible_injection",
        "possible_secret",
        "duplicate_requirement",
        "line_too_long",
        "not_a_requirement",
        "non_requirement_section"
      ]
    }
  }
}
