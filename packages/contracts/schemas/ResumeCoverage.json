{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeCoverage.json",
  "title": "ResumeCoverage",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "requirementId": {
      "$ref": "#/$defs/__schema0"
    },
    "priority": {
      "type": "string",
      "enum": [
        "must_have",
        "preferred",
        "context"
      ]
    },
    "strength": {
      "type": "string",
      "enum": [
        "exact",
        "related",
        "missing"
      ]
    },
    "factIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "requirementId",
    "priority",
    "strength",
    "factIds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    }
  }
}
