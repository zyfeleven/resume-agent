{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeIR.json",
  "title": "ResumeIR",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "headerFactIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "organizationFactId": {
            "$ref": "#/$defs/__schema0"
          },
          "roleFactId": {
            "$ref": "#/$defs/__schema0"
          },
          "dateFactIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          }
        },
        "required": [
          "id",
          "organizationFactId",
          "roleFactId",
          "dateFactIds",
          "bullets"
        ],
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "profileId",
    "headerFactIds",
    "summary",
    "skills",
    "experience",
    "projects",
    "education"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "factIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "text",
        "factIds",
        "requirementIds"
      ],
      "additionalProperties": false
    }
  }
}
