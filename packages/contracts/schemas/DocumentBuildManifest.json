{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentBuildManifest.json",
  "title": "DocumentBuildManifest",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "manifestId": {
      "$ref": "#/$defs/__schema0"
    },
    "operationId": {
      "$ref": "#/$defs/__schema0"
    },
    "resumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceContentHash": {
      "$ref": "#/$defs/__schema1"
    },
    "resultContentHash": {
      "$ref": "#/$defs/__schema1"
    },
    "changeSetId": {
      "$ref": "#/$defs/__schema0"
    },
    "changeSetHash": {
      "$ref": "#/$defs/__schema1"
    },
    "factSnapshotHash": {
      "$ref": "#/$defs/__schema1"
    },
    "requirementSnapshotHash": {
      "$ref": "#/$defs/__schema1"
    },
    "contentApprovalId": {
      "$ref": "#/$defs/__schema0"
    },
    "contentApprovalHash": {
      "$ref": "#/$defs/__schema1"
    },
    "templateId": {
      "$ref": "#/$defs/__schema0"
    },
    "templateVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "templateHash": {
      "$ref": "#/$defs/__schema1"
    },
    "templateProfileHash": {
      "$ref": "#/$defs/__schema1"
    },
    "sourceDocument": {
      "$ref": "#/$defs/__schema2"
    },
    "outputDocument": {
      "$ref": "#/$defs/__schema2"
    },
    "sourceSnapshotHash": {
      "$ref": "#/$defs/__schema1"
    },
    "outputSnapshotHash": {
      "$ref": "#/$defs/__schema1"
    },
    "operations": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "presentationPlanHash": {
      "$ref": "#/$defs/__schema1"
    },
    "presentationPlanArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "const": "document_ir"
        },
        "fileName": {
          "$ref": "#/$defs/__schema5"
        },
        "mediaType": {
          "$ref": "#/$defs/__schema6"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema1"
        },
        "byteSize": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "presentationBindings": {
      "minItems": 1,
      "maxItems": 20000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "claimProvenance": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "presentation": {
      "type": "string",
      "enum": [
        "clean",
        "tracked_changes",
        "tracked_changes_with_comments"
      ]
    },
    "builderName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "builderVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "runtimeHash": {
      "$ref": "#/$defs/__schema1"
    },
    "configurationHash": {
      "$ref": "#/$defs/__schema1"
    },
    "preservedPackagePartSetHash": {
      "$ref": "#/$defs/__schema1"
    },
    "manifestArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "const": "document_manifest"
        },
        "fileName": {
          "$ref": "#/$defs/__schema5"
        },
        "mediaType": {
          "$ref": "#/$defs/__schema6"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema1"
        },
        "byteSize": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "manifestHash": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "manifestId",
    "operationId",
    "resumeVersionId",
    "profileId",
    "sourceContentHash",
    "resultContentHash",
    "changeSetId",
    "changeSetHash",
    "factSnapshotHash",
    "contentApprovalId",
    "contentApprovalHash",
    "templateId",
    "templateVersion",
    "templateHash",
    "templateProfileHash",
    "sourceDocument",
    "outputDocument",
    "sourceSnapshotHash",
    "outputSnapshotHash",
    "operations",
    "presentationPlanHash",
    "presentationPlanArtifact",
    "presentationBindings",
    "claimProvenance",
    "presentation",
    "builderName",
    "builderVersion",
    "runtimeHash",
    "configurationHash",
    "preservedPackagePartSetHash",
    "manifestArtifact",
    "createdAt",
    "manifestHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_resume",
            "tailored_resume",
            "privacy_scrubbed_document",
            "other"
          ]
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.docx$"
            }
          ],
          "$ref": "#/$defs/__schema3"
        },
        "mediaType": {
          "type": "string",
          "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema1"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "__schema4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema0"
            },
            "changeId": {
              "$ref": "#/$defs/__schema0"
            },
            "contentItemId": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "type": "string",
              "const": "replace_block"
            },
            "targetBlockId": {
              "$ref": "#/$defs/__schema0"
            },
            "expectedTextHash": {
              "$ref": "#/$defs/__schema1"
            },
            "replacementTextHash": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "id",
            "changeId",
            "contentItemId",
            "kind",
            "targetBlockId",
            "expectedTextHash",
            "replacementTextHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema0"
            },
            "changeId": {
              "$ref": "#/$defs/__schema0"
            },
            "contentItemId": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "type": "string",
              "const": "insert_block_after"
            },
            "targetBlockId": {
              "$ref": "#/$defs/__schema0"
            },
            "expectedTextHash": {
              "$ref": "#/$defs/__schema1"
            },
            "insertedBlockId": {
              "$ref": "#/$defs/__schema0"
            },
            "insertedTextHash": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "id",
            "changeId",
            "contentItemId",
            "kind",
            "targetBlockId",
            "expectedTextHash",
            "insertedBlockId",
            "insertedTextHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema0"
            },
            "changeId": {
              "$ref": "#/$defs/__schema0"
            },
            "contentItemId": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "type": "string",
              "const": "remove_block"
            },
            "targetBlockId": {
              "$ref": "#/$defs/__schema0"
            },
            "expectedTextHash": {
              "$ref": "#/$defs/__schema1"
            }
          },
          "required": [
            "id",
            "changeId",
            "contentItemId",
            "kind",
            "targetBlockId",
            "expectedTextHash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema5": {
      "allOf": [
        {
          "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
        },
        {
          "pattern": "\\.json$"
        }
      ],
      "$ref": "#/$defs/__schema3"
    },
    "__schema6": {
      "type": "string",
      "const": "application/json"
    },
    "__schema7": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 52428800
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "presentationItemId": {
          "$ref": "#/$defs/__schema0"
        },
        "outputBlockId": {
          "$ref": "#/$defs/__schema0"
        },
        "outputTextHash": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "presentationItemId",
        "outputBlockId",
        "outputTextHash"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "contentItemId": {
          "$ref": "#/$defs/__schema0"
        },
        "outputBlockId": {
          "$ref": "#/$defs/__schema0"
        },
        "outputTextHash": {
          "$ref": "#/$defs/__schema1"
        },
        "resumeChangeId": {
          "$ref": "#/$defs/__schema0"
        },
        "factBindings": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "requirementIds": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "reviewDecisionIds": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "contentItemId",
        "outputBlockId",
        "outputTextHash",
        "resumeChangeId",
        "factBindings",
        "requirementIds",
        "reviewDecisionIds"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "factId": {
          "$ref": "#/$defs/__schema0"
        },
        "factVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "factHash": {
          "$ref": "#/$defs/__schema1"
        },
        "status": {
          "type": "string",
          "const": "verified"
        },
        "sourceArtifactIds": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "factId",
        "factVersion",
        "factHash",
        "status",
        "sourceArtifactIds"
      ],
      "additionalProperties": false
    }
  }
}
