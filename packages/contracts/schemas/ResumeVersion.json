{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeVersion.json",
  "title": "ResumeVersion",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "parentVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "templateId": {
      "$ref": "#/$defs/__schema0"
    },
    "resume": {
      "type": "object",
      "properties": {
        "profileId": {
          "$ref": "#/$defs/__schema0"
        },
        "headerFactIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema0"
              },
              "organizationFactId": {
                "$ref": "#/$defs/__schema0"
              },
              "roleFactId": {
                "$ref": "#/$defs/__schema0"
              },
              "dateFactIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "bullets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema1"
                }
              }
            },
            "required": [
              "id",
              "organizationFactId",
              "roleFactId",
              "dateFactIds",
              "bullets"
            ],
            "additionalProperties": false
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "education": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "profileId",
        "headerFactIds",
        "summary",
        "skills",
        "experience",
        "projects",
        "education"
      ],
      "additionalProperties": false
    },
    "changeSetId": {
      "$ref": "#/$defs/__schema0"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "fact_checked",
        "user_approved",
        "docx_built",
        "qa_passed",
        "finalized"
      ]
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "createdAt": {
      "$ref": "#/$defs/__schema2"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "id",
    "profileId",
    "templateId",
    "resume",
    "status",
    "contentHash",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "factIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "text",
        "factIds",
        "requirementIds"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  }
}
