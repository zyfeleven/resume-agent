{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentPrivacyReport.json",
  "title": "DocumentPrivacyReport",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "reportId": {
      "$ref": "#/$defs/__schema0"
    },
    "sourceDocument": {
      "$ref": "#/$defs/__schema1"
    },
    "outputDocument": {
      "$ref": "#/$defs/__schema1"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "policyHash": {
      "$ref": "#/$defs/__schema3"
    },
    "scrubberName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scrubberVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "runtimeHash": {
      "$ref": "#/$defs/__schema3"
    },
    "configurationHash": {
      "$ref": "#/$defs/__schema3"
    },
    "visibleContentPolicy": {
      "type": "string",
      "const": "preserve_exactly"
    },
    "sourceSnapshotHash": {
      "$ref": "#/$defs/__schema3"
    },
    "outputSnapshotHash": {
      "$ref": "#/$defs/__schema3"
    },
    "semanticTextHashBefore": {
      "$ref": "#/$defs/__schema3"
    },
    "semanticTextHashAfter": {
      "$ref": "#/$defs/__schema3"
    },
    "removed": {
      "$ref": "#/$defs/__schema4"
    },
    "remaining": {
      "$ref": "#/$defs/__schema4"
    },
    "packageSecurityRevalidated": {
      "type": "boolean",
      "const": true
    },
    "securityInspection": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "clean"
        },
        "detectedFormat": {
          "type": "string",
          "const": "docx_ooxml"
        },
        "packageMetrics": {
          "type": "object",
          "properties": {
            "compressedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expandedBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "largestEntryBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "entryCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumCompressionRatio": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "compressedBytes",
            "expandedBytes",
            "largestEntryBytes",
            "entryCount",
            "maximumCompressionRatio"
          ],
          "additionalProperties": false
        },
        "normalizedEntryNamesUnique": {
          "type": "boolean",
          "const": true
        },
        "crcAndSizesVerified": {
          "type": "boolean",
          "const": true
        },
        "hasMacros": {
          "type": "boolean",
          "const": false
        },
        "hasEncryptedPackage": {
          "type": "boolean",
          "const": false
        },
        "hasActiveX": {
          "type": "boolean",
          "const": false
        },
        "hasOleOrEmbeddedPackages": {
          "type": "boolean",
          "const": false
        },
        "hasAltChunk": {
          "type": "boolean",
          "const": false
        },
        "externalRelationshipCount": {
          "type": "number",
          "const": 0
        },
        "unsafeFieldCodeCount": {
          "type": "number",
          "const": 0
        },
        "unsafePackagePathCount": {
          "type": "number",
          "const": 0
        },
        "networkAccessAttempted": {
          "type": "boolean",
          "const": false
        },
        "findings": {
          "maxItems": 0,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "inspectedAt": {
          "$ref": "#/$defs/__schema6"
        },
        "inspectionHash": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "status",
        "detectedFormat",
        "packageMetrics",
        "normalizedEntryNamesUnique",
        "crcAndSizesVerified",
        "hasMacros",
        "hasEncryptedPackage",
        "hasActiveX",
        "hasOleOrEmbeddedPackages",
        "hasAltChunk",
        "externalRelationshipCount",
        "unsafeFieldCodeCount",
        "unsafePackagePathCount",
        "networkAccessAttempted",
        "findings",
        "inspectedAt",
        "inspectionHash"
      ],
      "additionalProperties": false
    },
    "reportArtifact": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "const": "privacy_report"
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.json$"
            }
          ],
          "$ref": "#/$defs/__schema2"
        },
        "mediaType": {
          "type": "string",
          "const": "application/json"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema3"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 52428800
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "$ref": "#/$defs/__schema6"
    },
    "reportHash": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "reportId",
    "sourceDocument",
    "outputDocument",
    "policyVersion",
    "policyHash",
    "scrubberName",
    "scrubberVersion",
    "runtimeHash",
    "configurationHash",
    "visibleContentPolicy",
    "sourceSnapshotHash",
    "outputSnapshotHash",
    "semanticTextHashBefore",
    "semanticTextHashAfter",
    "removed",
    "remaining",
    "packageSecurityRevalidated",
    "securityInspection",
    "reportArtifact",
    "createdAt",
    "reportHash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_resume",
            "tailored_resume",
            "privacy_scrubbed_document",
            "other"
          ]
        },
        "fileName": {
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
            },
            {
              "pattern": "\\.docx$"
            }
          ],
          "$ref": "#/$defs/__schema2"
        },
        "mediaType": {
          "type": "string",
          "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        },
        "contentHash": {
          "$ref": "#/$defs/__schema3"
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 26214400
        }
      },
      "required": [
        "artifactId",
        "kind",
        "fileName",
        "mediaType",
        "contentHash",
        "byteSize"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "coreProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "appProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "commentAuthors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "comments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trackedDeletions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revisionAuthors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hiddenTextRuns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "documentVariables": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customXmlParts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "thumbnails": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imageMetadataRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "externalRelationships": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "embeddedPackages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "coreProperties",
        "appProperties",
        "customProperties",
        "commentAuthors",
        "comments",
        "trackedDeletions",
        "revisionAuthors",
        "hiddenTextRuns",
        "documentVariables",
        "customXmlParts",
        "thumbnails",
        "imageMetadataRecords",
        "externalRelationships",
        "embeddedPackages"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "code": {
          "type": "string",
          "enum": [
            "path_traversal",
            "duplicate_entry",
            "unicode_path_collision",
            "archive_limit_exceeded",
            "invalid_crc_or_size",
            "symlink_or_device_entry",
            "macro",
            "activex",
            "ole_or_embedded_package",
            "alt_chunk",
            "external_relationship",
            "unsafe_field_code",
            "invalid_ooxml_content_type"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "high",
            "critical"
          ]
        },
        "partNameHash": {
          "$ref": "#/$defs/__schema3"
        },
        "redactedSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "code",
        "severity",
        "redactedSummary"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  }
}
