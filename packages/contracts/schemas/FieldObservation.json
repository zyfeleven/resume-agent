{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/FieldObservation.json",
  "title": "FieldObservation",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "applicationId": {
      "$ref": "#/$defs/__schema0"
    },
    "pageId": {
      "$ref": "#/$defs/__schema0"
    },
    "pageFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "controlType": {
      "type": "string",
      "enum": [
        "text",
        "email",
        "phone",
        "number",
        "date",
        "textarea",
        "select",
        "combobox",
        "radio",
        "checkbox",
        "toggle",
        "file",
        "button",
        "unknown"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "pii",
        "sensitive",
        "secret"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "value": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "locator": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "role",
            "label",
            "placeholder",
            "name",
            "test_id",
            "css",
            "xpath"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "exact": {
          "type": "boolean"
        },
        "framePath": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "strategy",
        "value",
        "exact",
        "framePath"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "applicationId",
    "pageId",
    "pageFingerprint",
    "question",
    "controlType",
    "required",
    "sensitivity",
    "options",
    "locator"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
