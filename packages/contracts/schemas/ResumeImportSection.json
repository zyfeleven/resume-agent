{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeImportSection.json",
  "title": "ResumeImportSection",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "header",
        "summary",
        "skills",
        "experience",
        "education",
        "projects",
        "certifications",
        "work_authorization",
        "unrecognized"
      ]
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "startLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "endLine": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "kind",
    "startLine",
    "endLine"
  ],
  "additionalProperties": false
}
