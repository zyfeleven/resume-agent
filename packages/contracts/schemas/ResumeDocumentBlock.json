{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/ResumeDocumentBlock.json",
  "title": "ResumeDocumentBlock",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "blockId": {
      "$ref": "#/$defs/__schema0"
    },
    "section": {
      "$ref": "#/$defs/__schema1"
    },
    "style": {
      "$ref": "#/$defs/__schema2"
    },
    "text": {
      "$ref": "#/$defs/__schema3"
    },
    "textHash": {
      "$ref": "#/$defs/__schema4"
    },
    "factIds": {
      "$ref": "#/$defs/__schema5"
    },
    "contentItemId": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "blockId",
    "section",
    "style",
    "text",
    "textHash",
    "factIds"
  ],
  "additionalProperties": false,
  "description": "One paragraph of the generated document. Every block cites the verified facts its text came from, so no line of the output is unattributable.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "header",
        "summary",
        "experience",
        "skills",
        "projects",
        "education"
      ]
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "name",
        "contact",
        "heading",
        "entry_heading",
        "entry_meta",
        "bullet",
        "line"
      ]
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "__schema4": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "__schema5": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "__schema6": {
      "$ref": "#/$defs/__schema0"
    }
  }
}
