{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/DocumentTrustedQaEvidenceRecord.json",
  "title": "DocumentTrustedQaEvidenceRecord",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "artifactId": {
      "$ref": "#/$defs/__schema0"
    },
    "contentHash": {
      "$ref": "#/$defs/__schema1"
    },
    "resumeVersionId": {
      "$ref": "#/$defs/__schema0"
    },
    "profileId": {
      "$ref": "#/$defs/__schema0"
    },
    "candidateArtifactId": {
      "$ref": "#/$defs/__schema0"
    },
    "candidateArtifactHash": {
      "$ref": "#/$defs/__schema1"
    },
    "checkKind": {
      "type": "string",
      "enum": [
        "package_security",
        "ooxml_integrity",
        "approved_text_diff",
        "ats_text_order",
        "structure",
        "styles_numbering",
        "links",
        "privacy_metadata",
        "accessibility",
        "render_complete",
        "visual_page_review",
        "claim_provenance"
      ]
    },
    "pageNumber": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "evidenceKind": {
      "type": "string",
      "enum": [
        "package_security_inspection",
        "ooxml_integrity_scan",
        "approved_text_diff",
        "ats_order_scan",
        "structure_scan",
        "styles_numbering_scan",
        "link_scan",
        "privacy_scan",
        "accessibility_scan",
        "render_manifest",
        "page_visual_inspection",
        "claim_provenance_audit"
      ]
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  },
  "required": [
    "artifactId",
    "contentHash",
    "resumeVersionId",
    "profileId",
    "candidateArtifactId",
    "candidateArtifactHash",
    "checkKind",
    "evidenceKind",
    "verifiedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    }
  }
}
