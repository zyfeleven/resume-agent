{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/RequirementFactMatch.json",
  "title": "RequirementFactMatch",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "requirementId": {
      "$ref": "#/$defs/__schema0"
    },
    "factIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "strength": {
      "type": "string",
      "enum": [
        "exact",
        "related",
        "missing",
        "conflict"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factId": {
            "$ref": "#/$defs/__schema0"
          },
          "basis": {
            "type": "string",
            "enum": [
              "keyword",
              "term_overlap",
              "term_and_duration",
              "semantic_model"
            ]
          },
          "terms": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema1"
            }
          }
        },
        "required": [
          "factId",
          "basis",
          "terms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requirementId",
    "factIds",
    "strength",
    "rationale",
    "confidence",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
