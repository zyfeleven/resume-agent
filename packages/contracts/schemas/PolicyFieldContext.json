{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/PolicyFieldContext.json",
  "title": "PolicyFieldContext",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "observationId": {
      "$ref": "#/$defs/__schema0"
    },
    "canonicalField": {
      "$ref": "#/$defs/__schema1"
    },
    "sensitivity": {
      "$ref": "#/$defs/__schema2"
    },
    "confidence": {
      "$ref": "#/$defs/__schema3"
    },
    "provenance": {
      "$ref": "#/$defs/__schema4"
    },
    "factStatus": {
      "$ref": "#/$defs/__schema5"
    },
    "sourceCount": {
      "$ref": "#/$defs/__schema6"
    },
    "answerReuse": {
      "$ref": "#/$defs/__schema7"
    },
    "tags": {
      "$ref": "#/$defs/__schema8"
    }
  },
  "required": [
    "observationId",
    "canonicalField",
    "sensitivity",
    "confidence",
    "provenance",
    "sourceCount",
    "tags"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "normal",
        "pii",
        "sensitive",
        "secret"
      ]
    },
    "__schema3": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "verified_fact",
        "answer_policy",
        "user_input",
        "none"
      ]
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ]
    },
    "__schema6": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "this_application_only",
        "reuse_with_confirmation",
        "always_ask"
      ]
    },
    "__schema8": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "string",
      "enum": [
        "protected_attribute",
        "work_authorization",
        "compensation",
        "relocation",
        "availability",
        "legal_declaration",
        "electronic_signature",
        "background_check"
      ]
    }
  }
}
