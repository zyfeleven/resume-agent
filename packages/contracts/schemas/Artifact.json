{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-agent.dev/schemas/1.0.0/Artifact.json",
  "title": "Artifact",
  "x-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "description": "Stable application-scoped entity identifier."
    },
    "kind": {
      "type": "string",
      "enum": [
        "source_resume",
        "tailored_resume",
        "job_description",
        "cover_letter",
        "screenshot",
        "browser_trace",
        "document_render",
        "submission_receipt",
        "manifest",
        "other"
      ]
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase SHA-256 digest."
    },
    "byteSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "storageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "normal",
        "pii",
        "sensitive",
        "secret"
      ]
    },
    "createdAt": {
      "$ref": "#/$defs/__schema0"
    },
    "expiresAt": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "id",
    "kind",
    "fileName",
    "mediaType",
    "contentHash",
    "byteSize",
    "storageKey",
    "sensitivity",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    }
  }
}
